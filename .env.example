# ============================================================
# Aktif sağlayıcı: teknofest | ollama | mock
#   teknofest -> yarışmanın ortak H200 API'si (VLM + LLM)
#   ollama    -> yerel geliştirme / demo yedeği
#   mock      -> model olmadan pipeline testi
# ============================================================
PROVIDER=ollama

# Birincil sağlayıcı çökerse buna düşer ("" = yedek yok)
# PROVIDER=teknofest iken varsayılan olarak ollama denenir.
FALLBACK_PROVIDER=ollama

# ---------- PROVIDER=teknofest (EVREN ortak API) ----------
# Dokümantasyon: https://evren-teknofest.ssyz.org.tr/
# OpenAI uyumlu temel URL (sondaki /v1 kalsın):
TEKNOFEST_BASE_URL=https://evren-llmapi.ssyz.org.tr/v1
# Maildeki "LLM API Anahtarı" — git'e koyma, sadece .env
TEKNOFEST_API_KEY=
# Resmi alias'lar (yanlış isim sessizce llm-fast'e düşer, 404 vermez):
VLM_MODEL=vlm
LLM_MODEL=llm-fast
# Video istekleri uzun sürebilir; resmi istemci tavanı 1800 sn.
# Aşağıdaki REQUEST_TIMEOUT=120 ollama içindir; teknofest'te satırı
# yorumlayın veya 1800 yazın (yoksa config 1800 varsayar).
# REQUEST_TIMEOUT=1800
#
# Maildeki Qdrant anahtarı RAG içindir (şimdilik Chroma duruyor, sonra bağlanır):
# QDRANT_API_KEY=
# QDRANT_URL=
#
# Maildeki Arayüz Kullanıcı / Parola = dokümantasyon sitesindeki API Konsolu,
# model çağrısı değil. Kodda kullanılmaz.

# ---------- PROVIDER=ollama (yerel) ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# 16GB Mac: qwen2.5vl:7b (hızlı) veya llama3.2-vision:11b (daha büyük, yavaş)
OLLAMA_MODEL=qwen2.5vl:7b
# Metin ajanları (risk + aksiyon) için; boşsa OLLAMA_MODEL kullanılır
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_NUM_CTX=16384

# ---------- Çağrı davranışı ----------
# ollama: 120 yeterli. teknofest + video: 1800 (veya bu satırı silin)
REQUEST_TIMEOUT=120
MAX_RETRIES=3
MAX_IMAGE_SIDE=768
VLM_CONCURRENCY=3

# ---------- Demo (1 dakikalık canlı gösterim) ----------
# 1 = YOLO kanıtı, ikinci bakış ve RAG kısılır; süre bütçesi öne geçer
DEMO_FAST_MODE=0
DEMO_MAX_FRAMES=8

# Kategori↔risk kilidi: severity_max (anlaşmazlıkta ağır olan) | category | risk
LOCK_POLICY=severity_max
# 1 = VLM metni sınıfla çelişince karesiz LLM eleştirmeni (demo süre bütçesine bağlı)
LABEL_CRITIC_LLM=1
