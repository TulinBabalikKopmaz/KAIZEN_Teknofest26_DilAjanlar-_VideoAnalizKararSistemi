# ============================================================
# Aktif sağlayıcı: teknofest | ollama | mock
#   teknofest -> yarışmanın ortak H200 API'si (VLM + LLM)
#   ollama    -> yerel geliştirme / demo yedeği
#   mock      -> model olmadan pipeline testi
# ============================================================
PROVIDER=ollama

# Birincil sağlayıcı çökerse buna düşer ("" = yedek yok)
# PROVIDER=teknofest iken varsayılan olarak ollama denenir.
FALLBACK_PROVIDER=ollama

# ---------- PROVIDER=teknofest (ortak API) ----------
# Tek endpoint iki model veriyorsa sadece şunları doldurmak yeterli:
# TEKNOFEST_BASE_URL=https://.../v1
# TEKNOFEST_API_KEY=...
# VLM_MODEL=Qwen3-VL-27B-Instruct
# LLM_MODEL=gemma-3-27b-it
#
# VLM ve LLM ayrı adreslerdeyse:
# VLM_BASE_URL=https://vlm.../v1
# VLM_API_KEY=...
# LLM_BASE_URL=https://llm.../v1
# LLM_API_KEY=...

# ---------- PROVIDER=ollama (yerel) ----------
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# 16GB Mac: qwen2.5vl:7b (hızlı) veya llama3.2-vision:11b (daha büyük, yavaş)
OLLAMA_MODEL=qwen2.5vl:7b
# Metin ajanları (risk + aksiyon) için; boşsa OLLAMA_MODEL kullanılır
OLLAMA_LLM_MODEL=qwen2.5vl:7b
OLLAMA_NUM_CTX=16384

# ---------- Çağrı davranışı ----------
REQUEST_TIMEOUT=120
MAX_RETRIES=3
MAX_IMAGE_SIDE=768
VLM_CONCURRENCY=3

# ---------- Demo (1 dakikalık canlı gösterim) ----------
# 1 = YOLO kanıtı, ikinci bakış ve RAG kısılır; süre bütçesi öne geçer
DEMO_FAST_MODE=0
DEMO_MAX_FRAMES=8
